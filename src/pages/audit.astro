---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import {
  auditBenefits,
  auditDeliverables,
  auditHero,
  auditHowItWorks,
  auditPricing,
  auditProblem,
  auditSolution,
} from "../content/audit.ts";
---

<BaseLayout
  title="Automation Audit - Martin Martinov"
  description="Get clarity before you invest. I'll audit your processes and create a custom automation roadmap - deterministic, reliable worfklows where possible, AI where necessary."
  path="/audit"
>
  {/* Hero Section */}
  <Section class="pt-16 sm:pt-20 pb-12 sm:pb-16" width="narrow" spacing="none">
    <div class="text-center">
      <h1
        class="text-4xl sm:text-5xl lg:text-6xl font-bold mb-6 sm:mb-8 text-slate-900 leading-tight"
        style="font-family: var(--font-display);"
      >
        {auditHero.headline}
      </h1>
      <p class="text-xl sm:text-2xl text-slate-600 mb-10 font-medium">
        {auditHero.subtitle}
      </p>
      <Button href={auditHero.ctaUrl} variant="primary">
        {auditHero.ctaText}
      </Button>
    </div>
  </Section>

  {/* Problem vs Solution */}
  <Section width="narrow" spacing="large">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <div class="border-l-4 border-red-600 pl-8">
        <h2
          class="text-2xl sm:text-3xl font-bold mb-6 text-slate-900"
          style="font-family: var(--font-display);"
        >
          {auditProblem.heading}
        </h2>
        <p class="text-slate-700 text-lg leading-relaxed mb-4">
          {auditProblem.description}
        </p>
        {auditProblem.stat && (
          <p class="text-slate-600 text-base italic">
            <a
              href={auditProblem.stat.url}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-slate-900 transition-colors underline decoration-slate-300 underline-offset-2"
            >
              {auditProblem.stat.text}
            </a>{" "}
            (Forbes)
          </p>
        )}
      </div>
      <div class="border-l-4 border-emerald-600 pl-8">
        <h2
          class="text-2xl sm:text-3xl font-bold mb-6 text-slate-900"
          style="font-family: var(--font-display);"
        >
          {auditSolution.heading}
        </h2>
        <p class="text-slate-700 text-lg leading-relaxed">
          {auditSolution.description}
        </p>
      </div>
    </div>
  </Section>

  {/* Deliverables */}
  <Section width="narrow" spacing="large">
    <h2
      class="text-3xl sm:text-4xl font-bold mb-16 text-center text-slate-900"
      style="font-family: var(--font-display);"
    >
      {auditDeliverables.heading}
    </h2>
    <div class="space-y-16">
      {auditDeliverables.items.map((item) => (
        <div class="border-l-4 border-slate-900 pl-8">
          <h3
            class="text-2xl sm:text-3xl font-bold text-slate-900 mb-4"
            style="font-family: var(--font-display);"
          >
            {item.title}
          </h3>
          <p class="text-xl text-slate-900 font-medium mb-4">{item.tagline}</p>
          <p class="text-lg text-slate-700 leading-relaxed">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </Section>

  {/* How It Works */}
  <Section width="narrow" spacing="large">
    <h2
      class="text-3xl sm:text-4xl font-bold mb-16 text-center text-slate-900"
      style="font-family: var(--font-display);"
    >
      {auditHowItWorks.heading}
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
      {auditHowItWorks.steps.map((step) => (
        <div class="text-center">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-900 text-white text-2xl font-bold mb-6">
            {step.step}
          </div>
          <h3
            class="text-xl sm:text-2xl font-bold text-slate-900 mb-3"
            style="font-family: var(--font-display);"
          >
            {step.title}
          </h3>
          <p class="text-slate-700 text-lg">{step.description}</p>
        </div>
      ))}
    </div>
  </Section>

  {/* Benefits */}
  <Section width="narrow" spacing="large">
    <h2
      class="text-3xl sm:text-4xl font-bold mb-12 text-center text-slate-900"
      style="font-family: var(--font-display);"
    >
      {auditBenefits.heading}
    </h2>
    <div class="border-l-4 border-slate-900 pl-8">
      <ul class="space-y-4">
        {auditBenefits.items.map((item) => (
          <li class="text-slate-700 text-lg pl-7 relative before:content-['→'] before:absolute before:left-0 before:text-slate-900 before:font-bold leading-relaxed">
            {item}
          </li>
        ))}
      </ul>
    </div>
  </Section>

  {/* Pricing */}
  <Section width="narrow" spacing="large">
    <div class="bg-slate-50 border-2 border-slate-900 p-10 text-center">
      <h2
        class="text-3xl sm:text-4xl font-bold mb-6 text-slate-900"
        style="font-family: var(--font-display);"
      >
        {auditPricing.heading}
      </h2>
      <p class="text-4xl sm:text-5xl font-bold text-slate-900 mb-8">
        {auditPricing.price}
      </p>
      <ul class="text-left max-w-md mx-auto space-y-3 mb-10">
        {auditPricing.details.map((detail) => (
          <li class="text-slate-700 text-lg pl-7 relative before:content-['→'] before:absolute before:left-0 before:text-slate-900 before:font-bold">
            {detail}
          </li>
        ))}
      </ul>
      <Button href={auditHero.ctaUrl} variant="primary">
        {auditHero.ctaText}
      </Button>
    </div>
  </Section>
</BaseLayout>
