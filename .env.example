# Environment Variables for mmartinov.com
# Local dev (`pnpm dev` / `pnpm preview`) reads these from .env.
# In production, set each one with: pnpm wrangler secret put <NAME>

# Resend API Key
# Get your API key from: https://resend.com/api-keys
# Required for contact form email delivery
RESEND_API_KEY=re_your_api_key_here

# HMAC key for contact-form anti-spam tokens
# Generate with: openssl rand -base64 32
ANTISPAM_SECRET_KEY=change-me

# RESEND_API_URL is optional and supplied by the e2e tests for their local stub.
# Leave it unset for normal development and production to use Resend.
