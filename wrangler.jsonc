{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mmartinov-com",
  "compatibility_date": "2026-10-01",
  // Served only on mmartinov.com; the workers.dev copy would duplicate the site
  "workers_dev": false,
  // Keep preview URLs for feature branches (they default to following workers_dev)
  "preview_urls": true,
  // Contact form throttle: about two submissions per minute per IP. The
  // namespace is unique in the account, so no other Worker shares its counters
  "ratelimits": [
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 2, "period": 60 },
    },
  ],
  "observability": {
    "enabled": true,
  },
}
