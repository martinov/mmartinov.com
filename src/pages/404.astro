---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
---

<BaseLayout
  title="Page Not Found"
  description="The page you're looking for doesn't exist."
  path=""
  noindex
>
  <Section
    class="pt-20 pb-12 sm:pt-24 sm:pb-16 lg:pt-28 lg:pb-20 min-h-[60vh] flex items-center"
    width="narrow"
    spacing="large"
  >
    <div class="text-center max-w-2xl mx-auto px-4">
      <div class="mb-8">
        <span
          class="text-8xl sm:text-9xl font-bold text-slate-200"
          style="font-family: var(--font-display);"
        >
          404
        </span>
      </div>
      <h1
        class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-6 text-slate-900"
        style="font-family: var(--font-display);"
      >
        Page Not Found
      </h1>
      <p class="text-lg sm:text-xl text-slate-700 mb-10 leading-relaxed">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href="/" variant="primary" fullWidthMobile>
          Back to Home
        </Button>
        <Button href="/contact" variant="secondary" fullWidthMobile>
          Get in Touch
        </Button>
      </div>
    </div>
  </Section>
</BaseLayout>
