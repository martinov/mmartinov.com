---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import { getCollection } from "astro:content";
import { otherExperience, workCta, workIntro } from "../content/work.ts";

const caseStudies = (await getCollection("work"))
  // Tiebreak on id so a duplicated order can't reshuffle /work between builds
  .toSorted((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id))
  .map(({ id, data }) => ({ id, ...data }));
---

<BaseLayout
  title="Work"
  description="Selected projects: Business process automation and AI integration case studies spanning travel, hiring, e-commerce, finance, and HVAC."
>
  {/* Page Heading */}
  <Section class="pt-16 sm:pt-20 pb-8 sm:pb-10" width="narrow" spacing="none">
    <div class="text-center">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl">{workIntro.heading}</h1>
    </div>
  </Section>

  {/* Case Studies */}
  {caseStudies.map((caseStudy, index) => (
    <Section
      id={caseStudy.id}
      class={index % 2 === 0 ? "" : "bg-slate-50"}
      width="narrow"
      spacing="large"
    >
      <div>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl mb-6 sm:mb-8">
          {caseStudy.title}
        </h2>

        {/* Challenge */}
        <div class="mb-10">
          <h3 class="text-xl sm:text-2xl mb-5 uppercase">
            {caseStudy.challenge.heading}
          </h3>
          <ul class="space-y-3">
            {caseStudy.challenge.points.map((point) => (
              <li class="text-slate-700 pl-7 relative before:content-['→'] before:absolute before:left-0 before:text-slate-900 before:font-bold leading-relaxed">
                {point}
              </li>
            ))}
          </ul>
        </div>

        {/* Solution */}
        <div class="mb-10">
          <h3 class="text-xl sm:text-2xl mb-5 uppercase">
            {caseStudy.solution.heading}
          </h3>
          <ul class="space-y-3">
            {caseStudy.solution.points.map((point) => (
              <li class="text-slate-700 pl-7 relative before:content-['→'] before:absolute before:left-0 before:text-slate-900 before:font-bold leading-relaxed">
                {point}
              </li>
            ))}
          </ul>
        </div>

        {/* Roadmap (for HVAC case study) */}
        {caseStudy.roadmap && (
          <div class="mb-10">
            <h3 class="text-xl sm:text-2xl mb-5 uppercase">
              {caseStudy.roadmap.heading}
            </h3>
            <div class="space-y-5">
              {caseStudy.roadmap.items.map((item) => (
                <div class="border-l-4 border-slate-900 pl-5 py-2">
                  <h4 class="mb-2 text-lg">{item.title}</h4>
                  <p class="text-slate-700 leading-relaxed">
                    {item.description}
                  </p>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* Approach (for HVAC case study) */}
        {caseStudy.approach && (
          <div class="mb-10">
            <h3 class="text-xl sm:text-2xl mb-5 uppercase">
              {caseStudy.approach.heading}
            </h3>
            <ul class="space-y-3">
              {caseStudy.approach.points.map((point) => (
                <li class="text-slate-700 pl-7 relative before:content-['→'] before:absolute before:left-0 before:text-slate-900 before:font-bold leading-relaxed">
                  {point}
                </li>
              ))}
            </ul>
          </div>
        )}

        {/* Insight (for HVAC case study) */}
        {caseStudy.insight && (
          <div class="mb-10">
            <h3 class="text-xl sm:text-2xl mb-5 uppercase">
              {caseStudy.insight.heading}
            </h3>
            <ul class="space-y-3">
              {caseStudy.insight.points.map((point) => (
                <li class="text-slate-700 pl-7 relative before:content-['→'] before:absolute before:left-0 before:text-slate-900 before:font-bold leading-relaxed">
                  {point}
                </li>
              ))}
            </ul>
          </div>
        )}

        {/* Outcome */}
        {caseStudy.outcome && (
          <div>
            <h3 class="text-xl sm:text-2xl mb-5 uppercase">
              {caseStudy.outcome.heading}
            </h3>
            <ul class="space-y-3">
              {caseStudy.outcome.points.map((point) => (
                <li class="text-slate-700 pl-7 relative before:content-['→'] before:absolute before:left-0 before:text-slate-900 before:font-bold leading-relaxed">
                  {typeof point === "string" ? (
                    point
                  ) : (
                    <>
                      {point.text}
                      <a
                        href={point.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="underline decoration-slate-400 hover:decoration-slate-900 hover:text-slate-900"
                      >
                        {point.label}
                      </a>
                    </>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </Section>
  ))}

  {/* Other Experience */}
  <Section width="narrow" class="border-t-2 border-slate-900">
    <div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl mb-6">
        {otherExperience.heading}
      </h2>
      <p class="text-slate-700 mb-5 text-lg leading-relaxed">
        {otherExperience.text}
      </p>
      <p class="text-slate-600 italic leading-relaxed">
        {otherExperience.note}
      </p>
    </div>
  </Section>

  {/* CTA */}
  <Section class="border-t-2 border-slate-900" spacing="large">
    <div class="relative max-w-3xl mx-auto text-center">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl mb-8">{workCta.text}</h2>
      <Button href={workCta.ctaLink} variant="primary">
        {workCta.ctaText}
      </Button>
    </div>
  </Section>
</BaseLayout>
