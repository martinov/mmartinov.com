---
import { siteConfig } from "../content/site.ts";

// Computed at render time: Workers freeze Date at the epoch during module load
const year = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-300 mt-20 border-t-2 border-slate-900">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 sm:gap-10">
      <div class="md:col-span-3">
        <h3
          class="text-base sm:text-lg font-semibold text-white mb-3"
          style="font-family: var(--font-display)"
        >
          Martin Martinov
        </h3>
        <p class="text-sm sm:text-base text-slate-400 max-w-md leading-relaxed">
          Software architect specializing in business process automation and AI
          integration
        </p>
      </div>

      <div class="md:text-right">
        <h3 class="text-sm font-semibold text-white mb-4 uppercase tracking-wider">
          Connect
        </h3>
        <ul class="space-y-3">
          <li>
            <a
              href={siteConfig.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-slate-400 hover:text-white transition-colors"
            >
              LinkedIn
            </a>
          </li>
          <li>
            <a
              href={siteConfig.social.github}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-slate-400 hover:text-white transition-colors"
            >
              GitHub
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 pt-8 border-t border-slate-700 flex flex-col sm:flex-row justify-between items-center gap-4 text-center sm:text-left">
      <p class="text-sm text-slate-400 leading-relaxed">
        Solutions Architect and co-owner at{" "}
        <a
          href="https://camplight.net?utm_source=mmartinov.com&utm_medium=footer&utm_campaign=personal-site-referral"
          target="_blank"
          rel="noopener"
          class="text-white hover:text-cyan-400 transition-colors font-medium underline underline-offset-2"
        >
          Camplight
        </a>
      </p>
      <p class="text-sm text-slate-400">© {year} Martin Martinov</p>
    </div>
  </div>
</footer>
