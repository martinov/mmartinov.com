---
import { navigation } from "../content/site.ts";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;
---

<header class="sticky top-0 z-50 w-full border-b-2 border-slate-900 bg-white">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16 sm:h-20">
      <a
        href="/"
        class="text-lg sm:text-xl font-bold text-slate-900 hover:text-cyan-700 transition-colors"
        style="font-family: var(--font-display)"
      >
        Martin Martinov
      </a>
      <ul class="flex gap-1 sm:gap-2">
        {navigation.map((item) => (
          <li>
            <a
              href={item.href}
              class={`text-sm sm:text-base font-medium transition-colors px-3 py-2 sm:px-4 sm:py-2 ${
                currentPath === item.href
                  ? "text-cyan-700 border-b-2 border-cyan-700"
                  : "text-slate-600 hover:text-slate-900"
              }`}
            >
              {item.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
</header>
