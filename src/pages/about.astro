---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import {
  aboutCta,
  aboutHero,
  aboutPhoto,
  beyondWork,
  howIWork,
  professionalJourney,
  story,
  technicalApproach,
} from "../content/about.ts";
---

<BaseLayout
  title="About"
  description="Two decades of software development. From coding at age 11 to building systems across finance, insurance, healthcare, and e-commerce. Based in Bulgaria, working globally."
  image="/og-image-with-portrait.png"
>
  {/* Hero */}
  <Section class="pt-16 sm:pt-20 pb-12 sm:pb-16" width="narrow" spacing="none">
    {/* Asymmetric Hero Grid with Photo */}
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center mb-16">
      {/* Photo Column */}
      <div class="order-2 lg:order-1 flex justify-center lg:justify-start">
        <picture class="block rounded-lg shadow-lg border border-slate-200 overflow-hidden w-full max-w-md lg:max-w-none">
          <source srcset={aboutPhoto.webpSrcSet} type="image/webp" />
          <img
            src={aboutPhoto.src}
            srcset={aboutPhoto.srcSet}
            alt={aboutPhoto.alt}
            width={aboutPhoto.width}
            height={aboutPhoto.height}
            class="w-full h-auto"
            style="animation: fadeSlideUp 0.6s ease-out;"
          />
        </picture>
      </div>

      {/* Content Column */}
      <div class="order-1 lg:order-2">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl">{aboutHero.heading}</h1>
        <p class="text-lg text-slate-700 leading-relaxed mt-6">
          {story.paragraphs[0]}
        </p>
      </div>
    </div>

    {/* The Story */}
    <div class="mb-16">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl mb-6">{story.heading}</h2>
      <div class="space-y-5">
        {story.paragraphs.slice(1).map((paragraph) => (
          <p class="text-lg text-slate-700 leading-relaxed">{paragraph}</p>
        ))}
      </div>
    </div>

    {/* Divider */}
    <div class="h-px bg-slate-300 mb-16"></div>

    {/* Professional Journey */}
    <div class="mb-16">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl mb-6">
        {professionalJourney.heading}
      </h2>
      <ul class="space-y-4">
        {professionalJourney.milestones.map((milestone) => (
          <li class="text-slate-700 text-lg pl-7 relative before:content-['→'] before:absolute before:left-0 before:text-slate-900 before:font-bold leading-relaxed">
            {milestone}
          </li>
        ))}
      </ul>
    </div>

    {/* Divider */}
    <div class="h-px bg-slate-300 mb-16"></div>

    {/* How I Work */}
    <div class="mb-16">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl mb-6">{howIWork.heading}</h2>
      <ul class="space-y-4">
        {howIWork.points.map((point) => (
          <li class="text-slate-700 text-lg pl-7 relative before:content-['→'] before:absolute before:left-0 before:text-slate-900 before:font-bold leading-relaxed">
            {typeof point === "string" ? (
              point
            ) : (
              <>
                {point.text.split(point.link.text)[0]}
                <a
                  href={point.link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-slate-900 font-semibold hover:text-cyan-700 transition-colors underline decoration-slate-300 hover:decoration-cyan-700 underline-offset-2"
                >
                  {point.link.text}
                </a>
                {point.text.split(point.link.text)[1]}
              </>
            )}
          </li>
        ))}
      </ul>
    </div>

    {/* Divider */}
    <div class="h-px bg-slate-300 mb-16"></div>

    {/* Technical Approach */}
    <div class="mb-16">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl mb-6">
        {technicalApproach.heading}
      </h2>
      <ul class="space-y-4">
        {technicalApproach.points.map((point) => (
          <li class="text-slate-700 text-lg pl-7 relative before:content-['→'] before:absolute before:left-0 before:text-slate-900 before:font-bold leading-relaxed">
            {point}
          </li>
        ))}
      </ul>
    </div>

    {/* Divider */}
    <div class="h-px bg-slate-300 mb-16"></div>

    {/* Beyond Work */}
    <div class="mb-8">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl mb-6">
        {beyondWork.heading}
      </h2>
      <ul class="space-y-4">
        {beyondWork.interests.map((interest) => (
          <li class="text-slate-700 text-lg pl-7 relative before:content-['→'] before:absolute before:left-0 before:text-slate-900 before:font-bold leading-relaxed">
            {interest}
          </li>
        ))}
      </ul>
    </div>
  </Section>

  {/* CTA */}
  <Section class="border-t-2 border-slate-900" spacing="large">
    <div class="relative max-w-3xl mx-auto text-center">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl mb-8">{aboutCta.text}</h2>
      <Button href={aboutCta.ctaLink} variant="primary">
        {aboutCta.ctaText}
      </Button>
    </div>
  </Section>
</BaseLayout>
